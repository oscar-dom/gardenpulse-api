# Copy this file to `.env` and adjust the values. `.env` is git-ignored.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# MongoDB connection string (local, Docker or Atlas)
#   Local/Docker: mongodb://localhost:27017/gardenpulse
#   Atlas:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gardenpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gardenpulse

# Secret used to sign JWT access tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Access token lifetime, in a format accepted by jsonwebtoken (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
