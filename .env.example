# Copy this file to `.env` and adjust the values. `.env` is git-ignored.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
# Keep the database name (/gardenpulse) before the "?": without it, data goes to a "test" database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gardenpulse?retryWrites=true&w=majority

# Secret used to sign JWT access tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Access token lifetime, in a format accepted by jsonwebtoken (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
